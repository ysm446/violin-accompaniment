{
  "name": "violin-accompaniment",
  "version": "0.1.0",
  "private": true,
  "description": "バイオリン演奏に追従する自動伴奏アプリ",
  "scripts": {
    "core": "cd core && .venv\\Scripts\\python -m violin_core --scores-dir ..\\scores",
    "ui": "npm --prefix ui run dev",
    "build": "npm --prefix ui run build",
    "test:core": "cd core && .venv\\Scripts\\python -m unittest discover -s tests -v",
    "app": "npm --prefix ui run app",
    "build:core": "cd core && .venv\\Scripts\\python -m PyInstaller --noconfirm --onedir --name violin_core run_core.py",
    "dist": "npm run build:core && npm --prefix ui run dist"
  }
}
